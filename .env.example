# Copy to .env and fill in. Never commit .env.

# One key per client account. The variable name is set by api_key_env in config/accounts/<client>.toml.
# ElevenLabs: needs conversation read access (+ agent write access only for `coach criteria push --apply`).
# ELEVENLABS_API_KEY_ACME=
# Optional: a second ElevenLabs key WITH "Agents: write" permission, named by api_write_key_env.
# Used only by `coach experiment start/stop` (branch + traffic split). Keeps the everyday key read-only.
# ELEVENLABS_WRITE_KEY_ACME=

# Fireflies accounts (source = "fireflies"): Fireflies → Integrations → Fireflies API. Free plan: 50 requests a day.
# FIREFLIES_API_KEY_TEAM=

# Recordings accounts (source = "recordings") use an ElevenLabs key with the "Speech to Text" permission.
# ELEVENLABS_API_KEY_TEAM=

# Checklist grader: jev (via OpenRouter, nothing changes on agents) or elevenlabs (free, needs criteria pushed to the agents)
GRADER=jev

# Report writer. Default: OpenRouter.
REPORT_PROVIDER=openrouter
# deepseek/deepseek-v4.1-flash  or  openai/gpt-6-luna
REPORT_MODEL=deepseek/deepseek-v4.1-flash
OPENROUTER_API_KEY=

# Only if REPORT_PROVIDER=anthropic (Claude API key with billing, not a Claude Code subscription)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
